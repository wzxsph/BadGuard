{
  "name": "badguard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "akshare:build": "python3 scripts/build_akshare_snapshot.py --output data/latest.json",
    "akshare:build:quick": "python3 scripts/build_akshare_snapshot.py --output data/latest.json --limit 500 --max-workers 8 --sleep 0",
    "dev": "wrangler dev --local --port 8787",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.107.1"
  }
}
